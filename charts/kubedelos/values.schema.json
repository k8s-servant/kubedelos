{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "kubedelos chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "clusterName": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespaceSelector": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "excludeImages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "retentionDays": {
      "type": "integer",
      "minimum": 0
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "readOnly": {
      "type": "boolean"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustProxyHeaders": {
          "type": "boolean"
        },
        "identityHeader": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "secureCookies": {
      "type": "boolean"
    },
    "extraAllowedHosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clusterDomain": {
      "type": "string"
    },
    "logLevel": {
      "type": "string"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
